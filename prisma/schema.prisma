generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  username          String             @unique
  password          String
  role              String             @default("user")
  elo               Int                @default(1000)
  sharpScore        Float              @default(0)
  emailVerified     Boolean            @default(false)
  verifyToken       String?
  verifyTokenExpiry DateTime?
  createdAt            DateTime           @default(now())
  mutedUntil                DateTime?
  violationCount            Int                @default(0)
  lastViolationAt           DateTime?
  stripeConnectedAccountId  String?
  subscriptionPriceCents    Int?
  commissionOverridePercent Int?
  picks                Pick[]
  followers         Follow[]           @relation("UserFollowing")
  following         Follow[]           @relation("UserFollowers")
  pushSubscriptions PushSubscription[]
  seasonResults     SeasonResult[]
  chatMessages      ChatMessage[]
  subscriptions     Subscription[]     @relation("UserSubscriptions")
  subscribers       Subscription[]     @relation("TipsterSubscribers")
  circlesOwned      Circle[]           @relation("CircleOwner")
  circleMemberships CircleMember[]
  circleMessages    CircleMessage[]
}

model Subscription {
  id               String    @id @default(cuid())
  followerId       String
  tipsterId        String
  stripeCustomerId String?
  stripeSubId      String?   @unique
  status           String    @default("inactive")
  priceAmount      Int       @default(1000)
  currency         String    @default("eur")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  follower         User      @relation("UserSubscriptions", fields: [followerId], references: [id])
  tipster          User      @relation("TipsterSubscribers", fields: [tipsterId], references: [id])

  @@unique([followerId, tipsterId])
}

model ChatRoom {
  id        String        @id @default(cuid())
  name      String        @unique
  type      String        @default("public")
  sport     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId],  references: [id])
  following   User     @relation("UserFollowing", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Pick {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  sport       String
  event       String
  fixtureId   String?
  homeTeam    String?
  awayTeam    String?
  market      String
  odds        Float
  stake       Float
  stakeType   String?   @default("units")
  result      String    @default("pending")
  pnl         Float     @default(0)
  confidence  String?
  reasoning   String?
  eloChange    Int?
  eloAfter     Int?
  lockedAt     DateTime?
  closingOdds     Float?
  clv             Float?
  visibility      String         @default("PUBLIC")
  seasonId        String?
  season          Season?   @relation(fields: [seasonId], references: [id])
  adminSettledBy  String?
  adminSettledAt  DateTime?         @db.Timestamptz(6)
  createdAt       DateTime  @default(now())
}

model PickReaction {
  id        String   @id @default(cuid())
  pickId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([pickId, userId, emoji])
}

model PickTail {
  id        String   @id @default(cuid())
  pickId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([pickId, userId])
}

model Season {
  id        String         @id @default(cuid())
  name      String
  number    Int            @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean        @default(false)
  champion  String?
  createdAt DateTime       @default(now())
  results   SeasonResult[]
  picks     Pick[]
}

model Circle {
  id          String          @id @default(cuid())
  name        String
  description String?
  sport       String?
  isPrivate   Boolean         @default(false)
  inviteCode  String          @unique
  ownerId     String
  createdAt   DateTime        @default(now())
  owner       User            @relation("CircleOwner", fields: [ownerId], references: [id])
  members     CircleMember[]
  messages    CircleMessage[]
}

model CircleMember {
  id        String   @id @default(cuid())
  circleId  String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  circle    Circle   @relation(fields: [circleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([circleId, userId])
}

model CircleMessage {
  id        String   @id @default(cuid())
  circleId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  circle    Circle   @relation(fields: [circleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model SeasonResult {
  id         String   @id @default(cuid())
  seasonId   String
  userId     String
  rank       Int
  roi        Float
  winRate    Float
  totalPicks Int
  totalPnL   Float
  sharpScore Float
  division   String
  createdAt  DateTime @default(now())
  season     Season   @relation(fields: [seasonId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([seasonId, userId])
}

model live_events {
  id           BigInt    @id @default(autoincrement())
  type         String    @db.VarChar(30)
  rarity       Int       @default(1) @db.SmallInt
  username     String?   @db.VarChar(50)
  targetUserId String?
  payload      Json
  createdAt    DateTime? @default(now()) @db.Timestamp(6)

  @@index([targetUserId, createdAt(sort: Desc)], map: "idx_le_broadcast")
  @@index([createdAt(sort: Desc)], map: "idx_le_created")
  @@index([type, createdAt(sort: Desc)], map: "idx_le_type")
}

model profiles {
  id               BigInt    @id @default(autoincrement())
  userId           String    @unique
  username         String    @db.VarChar(50)
  bio              String?
  social_twitter   String?   @db.VarChar(50)
  social_instagram String?   @db.VarChar(50)
  archetype        String?   @db.VarChar(30)
  banner           String?   @db.VarChar(30)
  border           String?   @db.VarChar(30)
  theme            String?   @db.VarChar(20)
  fav_sports       Json?
  avatar_b64       String?
  banner_b64       String?
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([username], map: "idx_profiles_username")
}

model ranking_history {
  id            BigInt    @id @default(autoincrement())
  userId        String
  username      String    @db.VarChar(50)
  isoWeek       String    @db.Char(8)
  elo           Int
  division      String    @db.VarChar(20)
  divisionScore Decimal   @db.Decimal(6, 2)
  sharpScore    Decimal   @db.Decimal(6, 2)
  roi           Decimal   @db.Decimal(8, 4)
  winRate       Decimal   @db.Decimal(6, 4)
  totalPicks    Int
  rank          Int?
  snapshotAt    DateTime? @default(now()) @db.Timestamp(6)

  @@unique([userId, isoWeek])
  @@index([isoWeek], map: "idx_rh_isoweek")
  @@index([userId], map: "idx_rh_userid")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model recent_picks_cache {
  userId    String
  slot      Int       @db.SmallInt
  result    String    @default("pending") @db.VarChar(10)
  sport     String?   @db.VarChar(30)
  market    String?   @db.VarChar(50)
  odds      Decimal?  @db.Decimal(8, 4)
  createdAt DateTime? @db.Timestamp(6)

  @@id([userId, slot])
  @@index([userId], map: "idx_rpc_userid")
}

model user_notifications {
  id        BigInt    @id @default(autoincrement())
  userId    String
  type      String    @db.VarChar(30)
  rarity    Int       @default(1) @db.SmallInt
  payload   Json
  readAt    DateTime? @db.Timestamp(6)
  createdAt DateTime? @default(now()) @db.Timestamp(6)

  @@index([userId, createdAt(sort: Desc)], map: "idx_un_user_created")
  @@index([userId, readAt], map: "idx_un_user_unread")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_rankings {
  userId           String    @id
  username         String    @db.VarChar(50)
  totalPicks       Int       @default(0)
  wins             Int       @default(0)
  losses           Int       @default(0)
  pushes           Int       @default(0)
  totalStake       Decimal   @default(0.00) @db.Decimal(12, 2)
  totalPnl         Decimal   @default(0.00) @db.Decimal(12, 2)
  roi              Decimal   @default(0.0000) @db.Decimal(8, 4)
  winRate          Decimal   @default(0.0000) @db.Decimal(6, 4)
  elo              Int       @default(1000)
  divisionScore    Decimal   @default(0.00) @db.Decimal(6, 2)
  division         String    @default("BRONZE") @db.VarChar(20)
  sharpScore       Decimal   @default(0.00) @db.Decimal(6, 2)
  reliabilityScore Decimal   @default(0.00) @db.Decimal(6, 2)
  clvAvg           Decimal?  @db.Decimal(8, 4)
  currentStreak    Int       @default(0)
  streakType       String    @default("none") @db.VarChar(10)
  bestStreak       Int       @default(0)
  archetype        String?   @db.VarChar(30)
  flowState        String?   @db.VarChar(30)
  isLive           Int       @default(0) @db.SmallInt
  lastPickAt       DateTime? @db.Timestamp(6)
  avgOdds          Decimal?  @db.Decimal(8, 4)
  clvSum           Decimal   @default(0.0000) @db.Decimal(12, 4)
  clvCount         Int       @default(0)
  createdAt        DateTime? @default(now()) @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @db.Timestamp(6)

  @@index([division], map: "idx_ur_division")
  @@index([elo(sort: Desc)], map: "idx_ur_elo")
  @@index([roi(sort: Desc)], map: "idx_ur_roi")
  @@index([updatedAt(sort: Desc)], map: "idx_ur_updated")
  @@index([username], map: "idx_ur_username")
}

model ModerationFlag {
  id        String   @id @default(cuid())
  userId    String
  reason    String   // 'auto-mute' | 'admin-review'
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)], map: "idx_modflag_user")
}
