generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  username          String             @unique
  password          String
  role              String             @default("user")
  elo               Int                @default(1000)
  sharpScore        Float              @default(0)
  emailVerified     Boolean            @default(false)
  verifyToken       String?
  verifyTokenExpiry DateTime?
  createdAt         DateTime           @default(now())
  picks             Pick[]
  followers         Follow[]           @relation("UserFollowing")
  following         Follow[]           @relation("UserFollowers")
  pushSubscriptions PushSubscription[]
  seasonResults     SeasonResult[]
  chatMessages      ChatMessage[]
  subscriptions     Subscription[]     @relation("UserSubscriptions")
  subscribers       Subscription[]     @relation("TipsterSubscribers")
  circlesOwned      Circle[]           @relation("CircleOwner")
  circleMemberships CircleMember[]
  circleMessages    CircleMessage[]
}

model Subscription {
  id               String    @id @default(cuid())
  followerId       String
  tipsterId        String
  stripeCustomerId String?
  stripeSubId      String?   @unique
  status           String    @default("inactive")
  priceAmount      Int       @default(1000)
  currency         String    @default("eur")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  follower         User      @relation("UserSubscriptions", fields: [followerId], references: [id])
  tipster          User      @relation("TipsterSubscribers", fields: [tipsterId], references: [id])

  @@unique([followerId, tipsterId])
}

model ChatRoom {
  id        String        @id @default(cuid())
  name      String        @unique
  type      String        @default("public")
  sport     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId],  references: [id])
  following   User     @relation("UserFollowing", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Pick {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  sport       String
  event       String
  fixtureId   String?
  homeTeam    String?
  awayTeam    String?
  market      String
  odds        Float
  stake       Float
  stakeType   String?   @default("units")
  result      String    @default("pending")
  pnl         Float     @default(0)
  confidence  String?
  reasoning   String?
  eloChange    Int?
  eloAfter     Int?
  lockedAt     DateTime?
  closingOdds  Float?
  clv          Float?
  seasonId     String?
  season       Season?   @relation(fields: [seasonId], references: [id])
  createdAt    DateTime  @default(now())
}

model PickReaction {
  id        String   @id @default(cuid())
  pickId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([pickId, userId, emoji])
}

model PickTail {
  id        String   @id @default(cuid())
  pickId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([pickId, userId])
}

model Season {
  id        String         @id @default(cuid())
  name      String
  number    Int            @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean        @default(false)
  champion  String?
  createdAt DateTime       @default(now())
  results   SeasonResult[]
  picks     Pick[]
}

model Circle {
  id          String          @id @default(cuid())
  name        String
  description String?
  sport       String?
  isPrivate   Boolean         @default(false)
  inviteCode  String          @unique
  ownerId     String
  createdAt   DateTime        @default(now())
  owner       User            @relation("CircleOwner", fields: [ownerId], references: [id])
  members     CircleMember[]
  messages    CircleMessage[]
}

model CircleMember {
  id        String   @id @default(cuid())
  circleId  String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  circle    Circle   @relation(fields: [circleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([circleId, userId])
}

model CircleMessage {
  id        String   @id @default(cuid())
  circleId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  circle    Circle   @relation(fields: [circleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model SeasonResult {
  id         String   @id @default(cuid())
  seasonId   String
  userId     String
  rank       Int
  roi        Float
  winRate    Float
  totalPicks Int
  totalPnL   Float
  sharpScore Float
  division   String
  createdAt  DateTime @default(now())
  season     Season   @relation(fields: [seasonId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([seasonId, userId])
}
